{
    "dataset": "twitter2015_rumor",
    "data_dir": "./output/rumor_labeled",
    "output_dir": "./output/gnn_optimized_twitter2015_rumor",
    "embedding_dim": 300,
    "hidden_dim": 256,
    "num_heads": 8,
    "dropout": 0.2,
    "alpha": 0.15,
    "use_residual": true,
    "num_layers": 3,
    "tfidf_max_features": 2000,
    "tfidf_ngram": [
        1,
        2
    ],
    "tfidf_min_df": 2,
    "maxlen": 50,
    "kernel_sizes": [
        2,
        3,
        4,
        5
    ],
    "batch_size": 64,
    "epochs": 30,
    "learning_rate": 0.0015,
    "weight_decay": 1e-05,
    "label_smoothing": 0.05,
    "gradient_accumulation_steps": 1,
    "early_stopping_patience": 10,
    "use_amp": true,
    "gradient_clip": 1.0,
    "num_classes": 2,
    "target_names": [
        "non-rumor",
        "rumor"
    ],
    "save_path": "./output/gnn_optimized_twitter2015_rumor/best_model.pth"
}